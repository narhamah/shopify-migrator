# Tara USA destination profile
#
# This is for the migration workspace, not for the embedded Tara Product Editor.
# Use a Shopify custom app on the USA store to generate DEST_ACCESS_TOKEN.
# Match the Saudi custom app pattern exactly:
# App name: Migration (receive)
# Scope string: see usa-migration-receive-scopes.txt
#
# Use the confirmed permanent myshopify domain from Shopify Admin > Settings > Domains.
# Candidate domains seen during store creation:
# - ixkpkn-za.myshopify.com
# - tara-usa-2.myshopify.com

DEST_NAME=usa

# Source store (the store you are migrating FROM)
SOURCE_SHOP_URL=your-source-store.myshopify.com
SOURCE_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destination store (Tara USA)
DEST_SHOP_URL=your-confirmed-usa-store.myshopify.com
DEST_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Magento source for USA storefront parity
MAGENTO_SITE_URL=https://taraformula.com
MAGENTO_STORE_CODE=us-en

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fresh English-only USA run:
# python setup_store.py
# python prepare_import.py
# python build_site.py --lang en
